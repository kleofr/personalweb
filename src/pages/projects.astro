---
import BaseLayout from '../layouts/BaseLayout.astro';
import projectsData from '../data/projects.json';
---

<BaseLayout
  title="Projects"
  description="Selected open-source projects, MLSecOps gateways, and network threat detection."
>
  <header class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 mb-2">
      Projects
    </h1>
    <p class="text-sm text-neutral-600 dark:text-neutral-400">
      Selected MLSecOps gateways, defensive LLM systems, and network threat classifiers.
    </p>
  </header>

  <section aria-label="Project list" class="space-y-8">
    {projectsData.map((project) => (
      <article class="space-y-2">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="font-medium text-neutral-900 dark:text-neutral-100 text-base">
            <a
              href={project.demo || project.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-blue-600 dark:hover:text-blue-400"
            >
              {project.title}
            </a>
          </h2>
          <div class="flex items-center space-x-3 text-xs shrink-0">
            {project.repo && (
              <a
                href={project.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
                aria-label={`Source code for ${project.title}`}
              >
                code &nearr;
              </a>
            )}
            {project.demo && (
              <a
                href={project.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
                aria-label={`Live demo for ${project.title}`}
              >
                demo &nearr;
              </a>
            )}
          </div>
        </div>
        <p class="text-neutral-600 dark:text-neutral-400">
          {project.description}
        </p>
        <div class="flex flex-wrap gap-x-2 gap-y-1 text-xs text-neutral-500">
          {project.tags.map((tag) => (
            <span>#{tag}</span>
          ))}
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
